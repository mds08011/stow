<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Same rule as backup_rules.xml: recordings stay on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio/" />
    </device-transfer>
</data-extraction-rules>
