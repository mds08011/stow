<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the transcript EditText. Colours come from values / values-night, so the
     box follows the app into dark mode; the stroke turns purple while it is being edited. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fieldFill" />
            <stroke android:width="2dp" android:color="@color/primaryText" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fieldFill" />
            <stroke android:width="1dp" android:color="@color/fieldStroke" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
